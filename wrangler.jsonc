{
  "name": "english-vocab-trainer",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["python_workers"],
  "keep_vars": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "migrations_dir": "src/english_vocab_trainer/migrations", "database_name": "english-vocab-trainer", "database_id": "ed8b9cc2-9ccf-4a7d-a61a-e7e63b2964f0"}],
  "r2_buckets": [{"binding": "AUDIO", "bucket_name": "english-vocab-trainer-audio"}],
  "env": {
    "preview": {
      "name": "english-vocab-trainer-preview",
      "keep_vars": true,
      "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
      "d1_databases": [{"binding": "DB", "migrations_dir": "src/english_vocab_trainer/migrations", "database_name": "english-vocab-trainer-preview", "database_id": "d0ab0afb-e9f0-4cda-85d5-4b7875e3228a"}],
      "r2_buckets": [{"binding": "AUDIO", "bucket_name": "english-vocab-trainer-audio"}]
    }
  }
}
